PORT=4000
FRONTEND_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5173
JWT_EXPIRES_IN=30d
COOKIE_EXPIRES_IN=30
# En producción: true si usas HTTPS
COOKIE_SECURE=false
# Si front y API están en dominios distintos: none (requiere COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
JWT_SECRET_KEY=cambia-este-secreto-largo-y-aleatorio
NODE_ENV=development

# true solo si la API corre detrás de un proxy inverso (nginx, Railway, Render).
# En local debe quedar en false: si no, se puede falsear X-Forwarded-For y
# saltarse los rate limiters.
TRUST_PROXY=false

SMTP_SERVICE=gmail
SMTP_MAIL=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Búsqueda de productos con IA (opcional). Sin ella el buscador con IA
# responde que no está disponible.
GEMINI_API_KEY=

CLOUDINARY_CLIENT_NAME=
CLOUDINARY_CLIENT_API=
CLOUDINARY_CLIENT_SECRET=

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce_db

CULQI_PUBLIC_KEY=pk_test_xxx
CULQI_SECRET_KEY=sk_test_xxx
CULQI_WEBHOOK_SECRET=

# Importe mínimo aceptado por tarjeta, en céntimos. Confirma el valor real de
# tu contrato con Culqi antes de cambiarlo.
CULQI_MONTO_MINIMO_CENTIMOS=300

STORE_EMAIL=
STORE_PHONE=
STORE_ADDRESS=

ENVIO_UMBRAL_GRATIS=50
ENVIO_PRECIO_DEFAULT=2

# Minutos que un pedido puede estar sin pagar antes de cancelarse
# y devolver el stock y el uso del cupón. Cada cuánto corre la revisión.
PEDIDO_EXPIRA_MINUTOS=30
PEDIDO_EXPIRA_INTERVALO_MINUTOS=5

# Acceso con Google. Se saca en console.cloud.google.com → APIs y servicios →
# Credenciales → ID de cliente de OAuth → Aplicación web, autorizando como
# "Orígenes de JavaScript" tu frontend (http://localhost:5173 y tu dominio).
# Si se deja vacío, el botón de Google no aparece y todo funciona igual.
GOOGLE_CLIENT_ID=

# Nombre del remitente en los correos (opcional). Sin él sale solo la dirección.
STORE_NAME=
